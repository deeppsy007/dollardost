    <script>
      import { calculateCreatorStack } from "../../lib/creator-stack/calculate";
      import type {
        CreatorStackInput,
        IncomeSource,
        FxRate,
        TaxReserve,
      } from "../../lib/creator-stack/types";

      const form = document.querySelector<HTMLFormElement>("#creator-stack-form")!;
      const sourcesContainer = document.querySelector<HTMLDivElement>("#income-sources")!;
      const sourceTemplate = document.querySelector<HTMLTemplateElement>("#income-source-template")!;
      const addSourceButton = document.querySelector<HTMLButtonElement>("#add-income-source")!;
      const errorBox = document.querySelector<HTMLDivElement>("#form-error")!;
      const results = document.querySelector<HTMLElement>("#results")!;
      const taxEnabled = document.querySelector<HTMLInputElement>("#tax-enabled")!;
      const taxFields = document.querySelector<HTMLDivElement>("#tax-fields")!;
      let sourceCounter = 0;

      const value = (root: ParentNode, field: string): string => {
        const element = root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-field="${field}"]`);
        return element?.value.trim() ?? "";
      };

      const numberValue = (root: ParentNode, field: string): number => {
        const raw = value(root, field);
        if (raw === "") throw new Error(`Please enter ${field.replaceAll(/([A-Z])/g, " $1").toLowerCase()}.`);
        const parsed = Number(raw);
        if (!Number.isFinite(parsed)) throw new Error(`Invalid number for ${field}.`);
        return parsed;
      };

      function updateSourceCard(card: HTMLElement) {
        const category = value(card, "category");
        const isYouTube = category === "youtube";
        const youtubeQuestion = card.querySelector<HTMLElement>(".youtube-question")!;
      
        const receivedCurrency = card.querySelector<HTMLElement>("[data-received-currency]")!;
        const platformFees = card.querySelector<HTMLElement>(".platform-fees")!;
        const routeFields = card.querySelector<HTMLElement>(".route-fields")!;

        youtubeQuestion.hidden = !isYouTube;

        const selectedStage = value(card, "amountStage");

        receivedCurrency.hidden = selectedStage !== "net_received";
        platformFees.hidden = selectedStage !== "contract_amount";
        routeFields.hidden = selectedStage === "net_received";

        const sourceCurrency = value(card, "currency");
const payoutCurrency = value(card, "payoutCurrency");

const receivedCurrencySelect =
  card.querySelector<HTMLSelectElement>('[data-field="receivedCurrency"]')!;

if (selectedStage === "net_received") {
  receivedCurrencySelect.value = sourceCurrency;
  receivedCurrencySelect.disabled = true;
} else {
  receivedCurrencySelect.disabled = false;
}
        const reportingCurrency = (document.querySelector<HTMLSelectElement>("#reporting-currency")!).value;
        const sourceRate = card.querySelector<HTMLInputElement>('[data-field="sourceReportingRate"]')!;
        const payoutRate = card.querySelector<HTMLInputElement>('[data-field="payoutReportingRate"]')!;

        sourceRate.required = sourceCurrency !== reportingCurrency;
        sourceRate.disabled = sourceCurrency === reportingCurrency;
        if (sourceRate.disabled) sourceRate.value = "";

        payoutRate.required = selectedStage !== "net_received" && payoutCurrency !== reportingCurrency;
        payoutRate.disabled = selectedStage === "net_received" || payoutCurrency === reportingCurrency;
        if (payoutRate.disabled) payoutRate.value = "";

        const noProcessing = card.querySelector<HTMLInputElement>('[data-field="noProcessingFee"]')!;
        const processingPercent = card.querySelector<HTMLInputElement>('[data-field="processingPercent"]')!;
        const processingFixed = card.querySelector<HTMLInputElement>('[data-field="processingFixed"]')!;
        processingPercent.required = selectedStage !== "net_received" && !noProcessing.checked;
        processingFixed.required = selectedStage !== "net_received" && !noProcessing.checked;
        processingPercent.disabled = selectedStage === "net_received" || noProcessing.checked;
        processingFixed.disabled = selectedStage === "net_received" || noProcessing.checked;

        routeFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((control) => {
          if (control.dataset.field === "processingPercent" || control.dataset.field === "processingFixed") return;
          control.disabled = selectedStage === "net_received";
        });
      }

      function addSource() {
        sourceCounter += 1;
        const fragment = sourceTemplate.content.cloneNode(true) as DocumentFragment;
        const card = fragment.querySelector<HTMLElement>(".source-card")!;
        card.dataset.sourceId = `income-${sourceCounter}`;
        card.querySelector<HTMLHeadingElement>("h3")!.textContent = `Income source ${sourceCounter}`;

        card.querySelector<HTMLButtonElement>(".remove")!.addEventListener("click", () => {
          card.remove();
          [...sourcesContainer.querySelectorAll<HTMLElement>(".source-card")].forEach((item, index) => {
            item.querySelector("h3")!.textContent = `Income source ${index + 1}`;
          });
        });

        const categorySelect = card.querySelector<HTMLSelectElement>('[data-field="category"]')!;
        const stageSelect = card.querySelector<HTMLSelectElement>('[data-field="amountStage"]')!;
        const youtubeRadios = [...card.querySelectorAll<HTMLInputElement>('[data-field="youtubeStage"]')];
        let selectedYoutubeRadio: HTMLInputElement | null =
          youtubeRadios.find((radio) => radio.checked) ?? null;

        categorySelect.addEventListener("change", () => {
          if (categorySelect.value !== "youtube") {
            youtubeRadios.forEach((radio) => {
              radio.checked = false;
            });
            selectedYoutubeRadio = null;
          }

          updateSourceCard(card);
        });

        stageSelect.addEventListener("change", () => updateSourceCard(card));
        card.querySelector<HTMLSelectElement>('[data-field="currency"]')!.addEventListener("change", () => updateSourceCard(card));
        card.querySelector<HTMLSelectElement>('[data-field="payoutCurrency"]')!.addEventListener("change", () => updateSourceCard(card));

        youtubeRadios.forEach((radio) => {
          radio.addEventListener("click", () => {
            if (selectedYoutubeRadio !== radio) return;

            radio.checked = false;
            selectedYoutubeRadio = null;
          });

          radio.addEventListener("change", () => {
            youtubeRadios.forEach((otherRadio) => {
              if (otherRadio !== radio) otherRadio.checked = false;
            });

            selectedYoutubeRadio = radio;
          });
        });
        card.querySelector<HTMLInputElement>('[data-field="noProcessingFee"]')!.addEventListener("change", () => updateSourceCard(card));
        sourcesContainer.append(fragment);
        updateSourceCard(card);
      }

      addSourceButton.addEventListener("click", addSource);
      document.querySelector<HTMLSelectElement>("#reporting-currency")!.addEventListener("change", () => {
        sourcesContainer.querySelectorAll<HTMLElement>(".source-card").forEach(updateSourceCard);
      });
      taxEnabled.addEventListener("change", () => {
        taxFields.hidden = !taxEnabled.checked;
        document.querySelector<HTMLInputElement>("#tax-percent")!.required = taxEnabled.checked;
        document.querySelector<HTMLInputElement>("#tax-eligibility-confirmed")!.required = taxEnabled.checked;
      });

      function formatMoney(amount: number, currency: string): string {
        try {
          return new Intl.NumberFormat(undefined, {
            style: "currency",
            currency,
            maximumFractionDigits: 2,
          }).format(amount);
        } catch {
          return `${amount.toFixed(2)} ${currency}`;
        }
      }

      function metric(label: string, amount: number, currency: string, highlight = false): HTMLElement {
        const box = document.createElement("div");
        box.className = `metric${highlight ? " highlight" : ""}`;
        const caption = document.createElement("span");
        caption.textContent = label;
        const strong = document.createElement("strong");
        strong.textContent = formatMoney(amount, currency);
        box.append(caption, strong);
        return box;
      }

      function renderResults(result: ReturnType<typeof calculateCreatorStack>) {
        const metrics = document.querySelector<HTMLDivElement>("#result-metrics")!;
        metrics.replaceChildren(
          metric("Estimated take-home", result.estimatedTakeHome, result.reportingCurrency, true),
          metric("Income entered", result.totalEnteredIncome, result.reportingCurrency),
          metric("Total modeled deductions", result.totalDeductions, result.reportingCurrency),
          metric("Platform fees", result.totalPlatformFees, result.reportingCurrency),
          metric("FX costs", result.totalFxCost, result.reportingCurrency),
          metric("Payment processing", result.totalPaymentProcessingFees, result.reportingCurrency),
          metric("Tax reserve estimate", result.estimatedTaxReserve, result.reportingCurrency),
          metric("Before tax reserve", result.amountBeforeTaxReserve, result.reportingCurrency),
          metric("Payment-route costs", result.totalPaymentRouteCosts, result.reportingCurrency),
        );

        const breakdown = document.querySelector<HTMLDivElement>("#source-breakdown")!;
        breakdown.replaceChildren();
        const table = document.createElement("table");
        table.className = "result-table";
        const headings = ["Income source", "Entered", "Platform fee", "FX cost", "Processing", "Received"];
        const head = document.createElement("tr");
        headings.forEach((heading) => {
          const th = document.createElement("th");
          th.textContent = heading;
          head.append(th);
        });
        const thead = document.createElement("thead");
        thead.append(head);
        const tbody = document.createElement("tbody");
        result.sourceResults.forEach((source) => {
          const row = document.createElement("tr");
          const cells = [
            source.sourceName,
            formatMoney(source.originalAmount, source.currency),
            formatMoney(source.platformFee, source.currency),
            formatMoney(source.fxCost, source.payoutCurrency),
            formatMoney(source.paymentProcessingFee, source.payoutCurrency),
            formatMoney(source.amountReceived, source.payoutCurrency),
          ];
          cells.forEach((content) => {
            const td = document.createElement("td");
            td.textContent = content;
            row.append(td);
          });
          tbody.append(row);
        });
        table.append(thead, tbody);
        breakdown.append(table);

        const leakBox = document.querySelector<HTMLDivElement>("#leak-breakdown")!;
        leakBox.replaceChildren();
        if (result.leakReport.length === 0) {
          leakBox.textContent = "No modeled fee leakage was reported from the values entered.";
        } else {
          const list = document.createElement("ul");
          list.className = "result-list";
          result.leakReport.forEach((leak) => {
            const item = document.createElement("li");
            item.textContent =
              `${leak.sourceName}: ${leak.leakType} — ${formatMoney(leak.costReporting, result.reportingCurrency)}. ${leak.action}` +
              (leak.isEstimate ? " (Estimate / unverified input)" : "");
            list.append(item);
          });
          leakBox.append(list);
        }

        const complianceBox = document.querySelector<HTMLDivElement>("#compliance-breakdown")!;
        complianceBox.replaceChildren();
        if (result.complianceChecklist.length === 0) {
          complianceBox.textContent = "No verified compliance rules were supplied to this calculation. Check the rules that apply to your own circumstances.";
        } else {
          const list = document.createElement("ul");
          list.className = "result-list";
          result.complianceChecklist.forEach((entry) => {
            const item = document.createElement("li");
            item.textContent = `${entry.label}: ${entry.appliesComputed ? "Potentially applies — review" : "Not matched by the entered conditions"} (${entry.jurisdiction}). ${entry.why}`;
            list.append(item);
          });
          complianceBox.append(list);
        }

        results.style.display = "block";
        results.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function buildInput(): CreatorStackInput {
        const reportingCurrency = document.querySelector<HTMLSelectElement>("#reporting-currency")!.value;
        const cards = [...sourcesContainer.querySelectorAll<HTMLElement>(".source-card")];
        if (cards.length === 0) throw new Error("Add at least one income source.");

        const fxRatesToReporting: Record<string, FxRate> = {};
        const addReportingRate = (currency: string, rawRate: string) => {
          if (currency === reportingCurrency) return;
          if (!rawRate) throw new Error(`Enter the ${currency} to ${reportingCurrency} reporting exchange rate.`);
          const rate = Number(rawRate);
          if (!Number.isFinite(rate) || rate <= 0) throw new Error(`The ${currency} to ${reportingCurrency} rate must be greater than zero.`);
          fxRatesToReporting[`${currency}_${reportingCurrency}`] = {
            rate,
            verificationStatus: "user_entered",
            note: "Exchange rate entered by the user.",
          };
        };

        const incomeSources: IncomeSource[] = cards.map((card, index) => {
          const category = value(card, "category") as IncomeSource["category"];
          let amountStage = value(card, "amountStage") as IncomeSource["amountStage"];


          const currency = value(card, "currency").toUpperCase();
          const amount = numberValue(card, "amount");
          const clientCountryCode = value(card, "clientCountryCode").toUpperCase();
          const isUsChoice = value(card, "isUsSource");
          const isUsSource = isUsChoice === "unknown" ? undefined : isUsChoice === "yes";

          let platformFeePercent = 0;
          let platformFixedFee = 0;
          let platformFixedFeeCurrency: "source" | "payout" = "source";

          if (amountStage === "contract_amount") {
            platformFeePercent = numberValue(card, "platformFeePercent");
            platformFixedFee = numberValue(card, "platformFixedFee");
            platformFixedFeeCurrency = value(card, "platformFixedFeeCurrency") as "source" | "payout";
          }

          const source: IncomeSource = {
            id: card.dataset.sourceId || `income-${index + 1}`,
            name: value(card, "name"),
            category,
            amount,
            currency,
            amountStage,
            platformFeePercent,
            platformFixedFee,
            platformFixedFeeCurrency,
            clientCountryCode,
            clientType: value(card, "clientType") as IncomeSource["clientType"],
            isUsSource,
          };

          if (amountStage === "net_received") {
            const receivedCurrency = value(card, "receivedCurrency").toUpperCase() || currency;
            source.receivedCurrency = receivedCurrency;
            addReportingRate(receivedCurrency, value(card, "sourceReportingRate"));
          } else {
            const payoutCurrency = value(card, "payoutCurrency").toUpperCase();
            addReportingRate(currency, value(card, "sourceReportingRate"));
            addReportingRate(payoutCurrency, value(card, "payoutReportingRate"));

            const noProcessingFee = card.querySelector<HTMLInputElement>('[data-field="noProcessingFee"]')!.checked;
            let processingFee: IncomeSource["paymentRoute"] extends infer _T ? import("../../lib/creator-stack/types").PaymentFeeModel : never;

            if (noProcessingFee) {
              processingFee = { kind: "none" };
            } else {
              const percent = numberValue(card, "processingPercent");
              const fixedAmount = numberValue(card, "processingFixed");
              processingFee = {
                kind: "percentage_plus_fixed",
                percentageFee: {
                  percent,
                  basis: value(card, "processingBasis") as "source_amount" | "payout_amount",
                },
                fixedFee: {
                  amount: fixedAmount,
                  currency: value(card, "processingFixedCurrency") as "source" | "payout",
                },
              };
            }

            source.paymentRoute = {
              providerName: value(card, "providerName"),
              payoutCountryCode: value(card, "payoutCountryCode").toUpperCase(),
              payoutCurrency,
              referenceExchangeRate: numberValue(card, "referenceExchangeRate"),
              fxMarkupPercent: numberValue(card, "fxMarkupPercent"),
              processingFee,
              availability: "unknown",
              availabilityNote: "Availability has not been independently confirmed.",
              verificationStatus: "user_entered",
              note: "Payment route values entered by the user; not provider-verified.",
            };
          }

          return source;
        });

        const taxIsEnabled = taxEnabled.checked;
        const taxPercentInput = document.querySelector<HTMLInputElement>("#tax-percent")!;
        const eligibilityConfirmed = document.querySelector<HTMLInputElement>("#tax-eligibility-confirmed")!.checked;

        if (taxIsEnabled && !eligibilityConfirmed) {
          throw new Error("To include a tax reserve estimate, independently confirm the tax treatment and eligibility for your planning assumption.");
        }

        const taxReserve: TaxReserve = {
          enabled: taxIsEnabled,
          percent: taxIsEnabled ? Number(taxPercentInput.value) : 0,
          base: document.querySelector<HTMLSelectElement>("#tax-base")!.value as TaxReserve["base"],
          verificationStatus: "user_entered",
          eligibility: {
            status: taxIsEnabled && eligibilityConfirmed ? "confirmed" : "not_confirmed",
            note: "User-entered planning reserve. This is not a determination of tax payable.",
          },
          note: "Planning estimate only; not tax payable.",
        };

        return {
          incomeSources,
          reportingCurrency,
          taxReserve,
          fxRatesToReporting,
          future: {
            whatIfEnabled: false,
            exportEnabled: false,
          },
        };
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        errorBox.style.display = "none";
        results.style.display = "none";

        try {
          if (!form.reportValidity()) return;
          const input = buildInput();
          const result = calculateCreatorStack(input);
          renderResults(result);
        } catch (error) {
          errorBox.textContent = error instanceof Error ? error.message : "Something went wrong. Check your entries and try again.";
          errorBox.style.display = "block";
          errorBox.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });

      addSource();
    </script>
  </body>
</html>

