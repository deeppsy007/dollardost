---
const title = "Creator Stack Calculator | Calculate Your Real Creator Income";
const description =
  "Calculate creator and freelancer income across platforms, payment providers and currencies. See platform fees, processing costs, FX leakage and estimated take-home income.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://dollardost.pages.dev/creator-stack-calculator/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://dollardost.pages.dev/creator-stack-calculator/" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f172a" />

    <style>
      :root {
        --primary: #0f172a;
        --accent: #16a34a;
        --accent-dark: #15803d;
        --text: #172033;
        --muted: #64748b;
        --border: #e2e8f0;
        --background: #f8fafc;
        --white: #fff;
        --warning-bg: #fff7ed;
        --warning-border: #fed7aa;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--text);
        background: var(--background);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      a { color: var(--accent-dark); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { width: min(1120px, calc(100% - 32px)); margin: auto; }
      header { background: var(--white); border-bottom: 1px solid var(--border); }
      .header-inner {
        min-height: 68px; display: flex; align-items: center;
        justify-content: space-between; gap: 20px;
      }
      .logo { color: var(--primary); font-size: 23px; font-weight: 850; letter-spacing: -1px; }
      .logo span { color: var(--accent); }
      nav { display: flex; gap: 22px; font-size: 14px; font-weight: 650; }
      nav a { color: var(--text); }
      .hero { padding: 48px 0 28px; text-align: center; }
      .eyebrow {
        display: inline-block; padding: 6px 13px; border-radius: 999px;
        background: #dcfce7; color: var(--accent-dark);
        font-size: 12px; font-weight: 800; letter-spacing: .06em;
      }
      h1 {
        max-width: 850px; margin: 15px auto 12px;
        font-size: clamp(32px, 5vw, 49px); line-height: 1.12; letter-spacing: -1.7px;
      }
      .hero p { max-width: 760px; margin: auto; color: var(--muted); font-size: 17px; }
      .trust-note {
        max-width: 900px; margin: 22px auto 0; padding: 13px 16px;
        border: 1px solid var(--warning-border); border-radius: 12px;
        background: var(--warning-bg); color: #7c2d12; font-size: 13px; text-align: left;
      }
      main { padding-bottom: 60px; }
      .panel {
        background: var(--white); border: 1px solid var(--border);
        border-radius: 18px; padding: 24px; margin: 18px auto;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .045);
      }
      .panel h2 { margin: 0 0 6px; font-size: 23px; letter-spacing: -.5px; }
      .sub { margin: 0 0 20px; color: var(--muted); font-size: 14px; }
      .source-card {
        border: 1px solid var(--border); border-radius: 14px;
        padding: 20px; margin: 16px 0; background: #fff;
      }
      .source-heading {
        display: flex; justify-content: space-between; align-items: center;
        gap: 12px; margin-bottom: 16px;
      }
      .source-heading h3 { margin: 0; font-size: 18px; }
      .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
      .field { min-width: 0; }
      .field.full { grid-column: 1 / -1; }
      label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 700; }
      input, select {
        width: 100%; min-height: 44px; padding: 10px 12px;
        border: 1px solid #cbd5e1; border-radius: 9px;
        background: #fff; color: var(--text); font: inherit; font-size: 14px;
      }
      input:focus, select:focus { outline: 2px solid #86efac; border-color: var(--accent); }
      input::placeholder { color: #94a3b8; }
      .hint { margin: 5px 0 0; color: var(--muted); font-size: 12px; }
      .warning {
        padding: 11px 13px; margin: 13px 0; border-radius: 10px;
        border: 1px solid var(--warning-border); background: var(--warning-bg);
        color: #7c2d12; font-size: 13px;
      }
      .info {
        padding: 11px 13px; margin: 13px 0; border-radius: 10px;
        border: 1px solid #bfdbfe; background: #eff6ff; color: #1e40af;
        font-size: 13px;
      }
      .section-title { margin: 23px 0 12px; font-size: 16px; font-weight: 800; }
      .check-row { display: flex; gap: 10px; align-items: flex-start; margin: 12px 0; }
      .check-row input { width: 18px; min-height: 18px; margin-top: 3px; }
      .check-row label { margin: 0; font-weight: 550; }
      .button-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
      button {
        min-height: 44px; padding: 10px 17px; border: 0; border-radius: 9px;
        background: var(--accent); color: #fff; font: inherit; font-weight: 750;
        cursor: pointer;
      }
      button:hover { background: var(--accent-dark); }
      button.secondary { background: #e2e8f0; color: var(--text); }
      button.secondary:hover { background: #cbd5e1; }
      button.remove { min-height: 34px; padding: 6px 10px; background: #fee2e2; color: #991b1b; font-size: 12px; }
      button:disabled { cursor: not-allowed; opacity: .55; }
      .primary-button { width: 100%; min-height: 52px; font-size: 16px; margin-top: 18px; }
      .error {
        display: none; padding: 13px; margin: 15px 0; border-radius: 10px;
        border: 1px solid #fecaca; background: #fef2f2; color: #991b1b;
      }
      #results { display: none; }
      .result-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
      .metric { padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: #fff; }
      .metric span { display: block; color: var(--muted); font-size: 12px; font-weight: 700; }
      .metric strong { display: block; margin-top: 5px; font-size: clamp(18px, 3vw, 25px); overflow-wrap: anywhere; }
      .metric.highlight { border-color: #86efac; background: #f0fdf4; }
      .result-list { padding-left: 20px; }
      .result-list li { margin: 7px 0; }
      .result-table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .result-table th, .result-table td { padding: 10px 8px; border-bottom: 1px solid var(--border); text-align: left; }
      .result-table th { color: var(--muted); }
      .disabled-features { color: var(--muted); font-size: 13px; }
            .content-section {
        max-width: 900px;
        margin: 30px auto;
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
      }

      .content-section h2 {
        margin: 0 0 18px;
        padding-bottom: 14px;
        border-bottom: 2px solid #e2e8f0;
        color: #0f172a;
        font-size: 25px;
        line-height: 1.3;
      }

      .content-section h3 {
        margin: 26px 0 12px;
        color: #1e293b;
        font-size: 19px;
        line-height: 1.4;
      }

      .content-section p,
      .content-section li {
        color: #475569;
        line-height: 1.75;
      }

      .content-section ul {
        padding-left: 22px;
      }

      .content-section li {
        margin: 7px 0;
      }

      .content-section .table-wrap {
        overflow-x: auto;
        margin: 18px 0 26px;
        border: 1px solid #dbe3ed;
        border-radius: 12px;
        background: #ffffff;
      }

      .content-section table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
      }

      .content-section th,
      .content-section td {
        padding: 14px 16px;
        border: 1px solid #e2e8f0;
        text-align: left;
        vertical-align: top;
      }

      .content-section th {
        background: #eff6ff;
        color: #1e3a8a;
        font-weight: 700;
      }

      .content-section tbody tr:nth-child(even) {
        background: #f8fafc;
      }

      .content-section tbody tr:hover {
        background: #f1f5f9;
      }

      .content-section details {
        margin: 10px 0;
        padding: 16px 18px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
      }

      .content-section summary {
        cursor: pointer;
        color: #1e40af;
        font-weight: 650;
        line-height: 1.6;
      }

      .content-section details[open] {
        background: #ffffff;
        border-color: #bfdbfe;
      }

      .content-section details p {
              .direct-answer {
        margin: 28px 0;
        padding: 22px 24px;
        border: 1px solid #bfdbfe;
        border-left: 5px solid #2563eb;
        border-radius: 12px;
        background: #eff6ff;
      }

      .direct-answer h3 {
        margin: 0 0 12px;
        color: #1e3a8a;
        font-size: 19px;
      }

      .direct-answer p,
      .direct-answer li {
        color: #334155;
      }

      .direct-answer p:last-child {
        margin-bottom: 0;
      }

      .direct-answer ol {
        padding-left: 22px;
      }

      .direct-answer li {
        margin: 7px 0;
        line-height: 1.7;
      }

      @media (max-width: 700px) {
        .direct-answer {
          padding: 18px 16px;
        }
      }
        margin: 12px 0 0;
      }

      @media (max-width: 700px) {
        .content-section {
          padding: 21px 17px;
          margin: 22px auto;
          border-radius: 14px;
        }

        .content-section h2 {
          font-size: 22px;
        }

        .content-section th,
        .content-section td {
          padding: 11px 12px;
          min-width: 130px;
        }
      }
      footer { padding: 28px 0; background: var(--primary); color: #cbd5e1; font-size: 13px; }
      footer a { color: #bbf7d0; }
      [hidden] { display: none !important; }

      @media (max-width: 700px) {
        .header-inner { align-items: flex-start; flex-direction: column; padding: 13px 0; }
        nav { flex-wrap: wrap; gap: 12px 17px; }
        .hero { padding-top: 34px; }
        .panel { padding: 17px; }
        .source-card { padding: 14px; }
        .form-grid, .result-grid { grid-template-columns: 1fr; }
        .result-table { display: block; overflow-x: auto; white-space: nowrap; }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container header-inner">
        <a class="logo" href="/">Dollar<span>Dost</span></a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#tools">Tools</a>
          <a href="/#about">About</a>
        </nav>
      </div>
    </header>

    <section class="hero container">
      <span class="eyebrow">CREATOR STACK CALCULATOR</span>
      <h1>What do you really keep from your creator income?</h1>
      <p>
        Combine income from platforms, clients and digital products.
        Account for platform deductions, payout fees and currency conversion
        to estimate what reaches you.
      </p>
      <div class="trust-note">
        <strong>Important:</strong> This calculator uses the fees, rates and
        assumptions you enter. Unverified provider presets are not treated as
        confirmed prices. Results are estimates, not financial, legal or tax advice.
      </div>
    </section>

    <main class="container">
      <form id="creator-stack-form" class="panel">
        <h2>1. Your income sources</h2>
        <p class="sub">
          Add each platform, client, affiliate or product income stream separately.
          You can combine different currencies and payout routes.
        </p>

        <div class="form-grid">
          <div class="field">
            <label for="reporting-currency">Reporting currency</label>
            <select id="reporting-currency" required>
              <option value="" selected disabled>Select reporting currency</option>
              <option value="INR">INR — Indian Rupee</option>
              <option value="USD">USD — US Dollar</option>
              <option value="EUR">EUR — Euro</option>
              <option value="GBP">GBP — British Pound</option>
              <option value="PHP">PHP — Philippine Peso</option>
              <option value="NGN">NGN — Nigerian Naira</option>
              <option value="PKR">PKR — Pakistani Rupee</option>
              <option value="BDT">BDT — Bangladeshi Taka</option>
              <option value="CAD">CAD — Canadian Dollar</option>
              <option value="AUD">AUD — Australian Dollar</option>
            </select>
          </div>
        </div>

        <div id="income-sources"></div>

        <template id="income-source-template">
          <article class="source-card">
            <div class="source-heading">
              <h3>Income source</h3>
              <button type="button" class="remove">Remove</button>
            </div>

            <div class="form-grid">
              <div class="field">
                <label>Platform, client or income name</label>
                <input data-field="name" required maxlength="100" placeholder="e.g. YouTube, freelance client" />
              </div>
              <div class="field">
                <label>Income category</label>
                <select data-field="category" required>
                  <option value="" selected disabled>Select a category</option>
                  <option value="youtube">YouTube</option>
                  <option value="sponsorship">Sponsorship</option>
                  <option value="freelance">Freelance</option>
                  <option value="affiliate">Affiliate</option>
                  <option value="digital_product">Digital product</option>
                  <option value="ugc">UGC</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="field">
                <label>Amount</label>
                <input data-field="amount" type="number" min="0.01" step="any" required placeholder="Enter amount" />
              </div>
              <div class="field">
                <label>Currency of this amount</label>
                <select data-field="currency" required>
                  <option value="" selected disabled>Select amount currency</option>
                  <option value="USD">USD</option>
                  <option value="INR">INR</option>
                  <option value="EUR">EUR</option>
                  <option value="GBP">GBP</option>
                  <option value="PHP">PHP</option>
                  <option value="NGN">NGN</option>
                  <option value="PKR">PKR</option>
                  <option value="BDT">BDT</option>
                  <option value="CAD">CAD</option>
                  <option value="AUD">AUD</option>
                </select>
              </div>
              <div class="field">
                <label>What does this amount represent?</label>
                <select data-field="amountStage" required>
                  <option value="contract_amount">Before platform fees / deductions</option>
                  <option value="after_platform">After platform fees / deductions</option>
                  <option value="net_received">Already received in my account</option>
                </select>
              </div>
              <div class="field" data-received-currency hidden>
                <label>Currency already received</label>
                <select data-field="receivedCurrency">
                  <option value="USD">USD</option><option value="INR">INR</option>
                  <option value="EUR">EUR</option><option value="GBP">GBP</option>
                  <option value="PHP">PHP</option><option value="NGN">NGN</option>
                  <option value="PKR">PKR</option><option value="BDT">BDT</option>
                  <option value="CAD">CAD</option><option value="AUD">AUD</option>
                </select>
              </div>
            </div>

            <div class="youtube-question warning" hidden>
              <strong>YouTube revenue stage — required:</strong>
              <p>Is this amount before YouTube share, or YouTube Studio estimated revenue?</p>
              <div class="check-row">
                <input type="radio" data-field="youtubeStage" value="before_share" />
                <label>Before YouTube share (gross amount before platform share)</label>
              </div>
              <div class="check-row">
                <input type="radio" data-field="youtubeStage" value="studio_estimate" />
                <label>YouTube Studio estimated revenue (creator-side estimate after YouTube share)</label>
              </div>
              <p class="hint">The second choice prevents the calculator from deducting YouTube's share a second time.</p>
            </div>

            <div class="platform-fees">
              <div class="section-title">Platform fee</div>
              <div class="warning">
                <strong>Enter your fee.</strong> No verified fee is being assumed
                for this preset. Check your current contract, account or transaction
                statement. A blank fee is not zero.
              </div>
              <div class="form-grid">
                <div class="field">
                  <label>Platform fee (%)</label>
                  <input data-field="platformFeePercent" type="number" min="0" max="100" step="any" placeholder="Enter your fee percentage" />
                </div>
                <div class="field">
                  <label>Fixed platform fee</label>
                  <input data-field="platformFixedFee" type="number" min="0" step="any" placeholder="Enter fixed fee (use 0 if none)" />
                </div>
                <div class="field">
                  <label>Fixed fee currency basis</label>
                  <select data-field="platformFixedFeeCurrency">
                    <option value="source">Source currency</option>
                    <option value="payout">Payout currency</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="route-fields">
              <div class="section-title">Payment and payout route</div>
              <div class="warning">
                <strong>Enter your own route details.</strong> Provider names are
                not fee or rate confirmations. Reference rate, FX markup and
                processing fees must come from your current account or transaction.
              </div>
              <div class="form-grid">
                <div class="field">
                  <label>Payment provider</label>
                  <input data-field="providerName" required placeholder="Enter provider name" />
                </div>
                <div class="field">
                  <label>Payout country code</label>
                  <input data-field="payoutCountryCode" required minlength="2" maxlength="2" pattern="[A-Za-z]{2}" placeholder="e.g. IN" />
                </div>
                <div class="field">
                  <label>Payout currency</label>
                  <select data-field="payoutCurrency" required>
                    <option value="INR" selected>INR</option><option value="USD">USD</option>
                    <option value="EUR">EUR</option><option value="GBP">GBP</option>
                    <option value="PHP">PHP</option><option value="NGN">NGN</option>
                    <option value="PKR">PKR</option><option value="BDT">BDT</option>
                    <option value="CAD">CAD</option><option value="AUD">AUD</option>
                  </select>
                </div>
                <div class="field">
                  <label>Reference exchange rate (source → payout)</label>
                  <input data-field="referenceExchangeRate" type="number" min="0.0000001" step="any" required placeholder="Enter rate from your source" />
                </div>
                <div class="field">
                  <label>FX markup (%)</label>
                  <input data-field="fxMarkupPercent" type="number" min="0" max="99.999999" step="any" required placeholder="Enter markup; use 0 if none" />
                </div>
                <div class="field">
                  <label>Processing fee (%)</label>
                  <input data-field="processingPercent" type="number" min="0" max="100" step="any" placeholder="Enter processing percentage" />
                </div>
                <div class="field">
                  <label>Fixed processing fee</label>
                  <input data-field="processingFixed" type="number" min="0" step="any" placeholder="Enter fixed fee" />
                </div>
                <div class="field">
                  <label>Fixed processing fee currency</label>
                  <select data-field="processingFixedCurrency">
                    <option value="source">Source currency</option>
                    <option value="payout">Payout currency</option>
                  </select>
                </div>
                <div class="field">
                  <label>Processing fee basis</label>
                  <select data-field="processingBasis">
                    <option value="source_amount">Source amount</option>
                    <option value="payout_amount">Payout amount</option>
                  </select>
                </div>
              </div>
              <div class="check-row">
                <input type="checkbox" data-field="noProcessingFee" />
                <label>I checked my route and confirmed there is no processing fee.</label>
              </div>
              <p class="hint">If you do not know the processing fee, do not check this box. Find the current fee first.</p>
            </div>

            <div class="field source-country">
              <div class="section-title">Client and source details</div>
              <div class="form-grid">
                <div class="field">
                  <label>Client / payer country code</label>
                  <input data-field="clientCountryCode" required minlength="2" maxlength="2" pattern="[A-Za-z]{2}" placeholder="e.g. US" />
                </div>
                <div class="field">
                  <label>Client type</label>
                  <select data-field="clientType">
                    <option value="direct_client">Direct client</option>
                    <option value="platform">Platform</option>
                    <option value="brand">Brand</option>
                    <option value="affiliate_network">Affiliate network</option>
                  </select>
                </div>
                <div class="field">
                  <label>Is this a US-source payment?</label>
                  <select data-field="isUsSource">
                    <option value="unknown">Not established / unsure</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                  </select>
                </div>
              </div>
              <p class="hint">Do not infer US-source status from the payer's country alone. Establish it from the applicable tax documentation.</p>
            </div>

            <div class="section-title">Reporting-currency conversion</div>
            <div class="form-grid">
              <div class="field">
                <label>Source currency → reporting currency rate</label>
                <input data-field="sourceReportingRate" type="number" min="0.0000001" step="any" placeholder="Enter rate; not needed for same currency" />
                <p class="hint">Use the rate for 1 unit of source currency in your reporting currency.</p>
              </div>
              <div class="field payout-reporting-field">
                <label>Payout currency → reporting currency rate</label>
                <input data-field="payoutReportingRate" type="number" min="0.0000001" step="any" placeholder="Enter rate; not needed for same currency" />
                <p class="hint">Use the rate for 1 unit of payout currency in your reporting currency.</p>
              </div>
            </div>
          </article>
        </template>

        <div class="button-row">
          <button type="button" class="secondary" id="add-income-source">+ Add another income source</button>
        </div>

        <div class="section-title">2. Optional tax reserve planning</div>
        <div class="info">
          This is an optional user-entered planning reserve, not a tax calculation
          or tax payable amount. Do not use a tax reference preset unless its
          converter returns verified and you have independently confirmed eligibility.
        </div>
        <div class="check-row">
          <input id="tax-enabled" type="checkbox" />
          <label for="tax-enabled">Include a user-entered tax reserve estimate</label>
        </div>
        <div id="tax-fields" class="form-grid" hidden>
          <div class="field">
            <label for="tax-percent">My planning reserve (%)</label>
            <input id="tax-percent" type="number" min="0" max="100" step="any" placeholder="Enter your own reserve percentage" />
          </div>
          <div class="field">
            <label for="tax-base">Apply reserve to</label>
            <select id="tax-base">
              <option value="amount_received">Amount received</option>
              <option value="gross">Gross income (only when gross is known for all sources)</option>
            </select>
          </div>
          <div class="field full">
            <div class="check-row">
              <input id="tax-eligibility-confirmed" type="checkbox" />
              <label for="tax-eligibility-confirmed">
                I have independently confirmed the tax treatment and my eligibility
                for the planning assumption I am entering.
              </label>
            </div>
          </div>
        </div>

        <div id="form-error" class="error" role="alert"></div>
        <button class="primary-button" type="submit">Calculate my Creator Stack</button>
      </form>

      <section id="results" class="panel" aria-live="polite">
        <h2>3. Your estimated Creator Stack</h2>
        <p class="sub">Calculated from the information and assumptions you entered.</p>
        <div id="result-metrics" class="result-grid"></div>
        <h3 class="section-title">Income source breakdown</h3>
        <div id="source-breakdown"></div>
        <h3 class="section-title">Where money is leaking</h3>
        <div id="leak-breakdown"></div>
