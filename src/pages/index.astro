<script>
  const amountInput = document.querySelector("#amount");
  const rateInput = document.querySelector("#rate");
  const feeInput = document.querySelector("#fee");
  const fixedFeeInput = document.querySelector("#fixedFee");

  const fromCurrency = document.querySelector("#fromCurrency");
  const toCurrency = document.querySelector("#toCurrency");

  const result = document.querySelector("#result");
  const gross = document.querySelector("#gross");
  const feeAmount = document.querySelector("#feeAmount");
  const fixedAmount = document.querySelector("#fixedAmount");
  const net = document.querySelector("#net");
  const originalAmount = document.querySelector("#originalAmount");

  const amountSymbol = document.querySelector("#amountSymbol");
  const fixedFeeSymbol = document.querySelector("#fixedFeeSymbol");
  const rateHint = document.querySelector("#rateHint");
  const swapButton = document.querySelector("#swapCurrencies");

  function formatMoney(value, currency) {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: currency,
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(value);
  }

  function getCurrencySymbol(currency) {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: currency,
    })
      .formatToParts(0)
      .find((part) => part.type === "currency")
      .value;
  }

  function updateCurrencyLabels() {
    const source = fromCurrency.value;
    const destination = toCurrency.value;
    const rate = Number(rateInput.value) || 0;

    amountSymbol.textContent = getCurrencySymbol(source);
    fixedFeeSymbol.textContent = getCurrencySymbol(destination);

    rateHint.textContent =
      `1 ${source} = ${rate} ${destination} (manually entered rate)`;
  }

  function calculate() {
    const amount = Number(amountInput.value) || 0;
    const rate = Number(rateInput.value) || 0;
    const feePercent = Number(feeInput.value) || 0;
    const fixedFee = Number(fixedFeeInput.value) || 0;

    const source = fromCurrency.value;
    const destination = toCurrency.value;

    const convertedAmount = amount * rate;
    const processingFee = convertedAmount * (feePercent / 100);
    const totalFees = processingFee + fixedFee;
    const netAmount = Math.max(0, convertedAmount - totalFees);

    result.textContent = formatMoney(netAmount, destination);
    gross.textContent = formatMoney(convertedAmount, destination);
    feeAmount.textContent =
      "− " + formatMoney(processingFee, destination);
    fixedAmount.textContent =
      "− " + formatMoney(fixedFee, destination);
    net.textContent = formatMoney(netAmount, destination);
    originalAmount.textContent = formatMoney(amount, source);

    updateCurrencyLabels();
  }

  function changeCurrencies() {
    // Reset the exchange rate because the new pair needs a new rate.
    rateInput.value = "1";
    updateCurrencyLabels();
    calculate();
  }

  fromCurrency.addEventListener("change", changeCurrencies);
  toCurrency.addEventListener("change", changeCurrencies);

  amountInput.addEventListener("input", calculate);
  rateInput.addEventListener("input", calculate);
  feeInput.addEventListener("input", calculate);
  fixedFeeInput.addEventListener("input", calculate);

  swapButton.addEventListener("click", () => {
    const oldFrom = fromCurrency.value;
    const oldTo = toCurrency.value;
    const oldRate = Number(rateInput.value);

    fromCurrency.value = oldTo;
    toCurrency.value = oldFrom;

    if (oldRate > 0) {
      rateInput.value = (1 / oldRate).toPrecision(8);
    }

    calculate();
  });

  calculate();
</script>

